includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    # Define the paths we should be checking
    paths:
        - app/

    # Define additional config directories
    configDirectories:
        - config
    #   - /path/to/your/additional/config

    # Level 10 is the highest level
    level: 5

